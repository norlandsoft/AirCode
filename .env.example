# Anthropic API Key（必填，本机直连，无登录）
ANTHROPIC_API_KEY=

# 可选：默认工作区；不设则用进程 cwd
# AIRCODE_WORKSPACE=/path/to/project

# 服务绑定（远程开发默认 0.0.0.0）
# HOST=0.0.0.0
# PORT=8787

# CORS 来源（逗号分隔）；不设则允许常见 localhost
# AIRCODE_CORS_ORIGIN=http://localhost:5173,http://192.168.1.10:5173

# 可选：Claude Code 可执行文件
# CLAUDE_CODE_EXECUTABLE=/path/to/claude
