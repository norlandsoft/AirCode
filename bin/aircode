#!/usr/bin/env bash
# AirCode 启动器：构建 Web UI（如需要）并启动本地 Server。
# 浏览器访问 http://127.0.0.1:3456（或 SERVER_PORT 指定端口）即可使用。
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

cd "$ROOT_DIR"

if [[ "${CC_HAHA_SKIP_DOTENV:-0}" == "1" ]]; then
  ENV_FILE_FLAG="--env-file=/dev/null"
elif [[ -f .env ]]; then
  ENV_FILE_FLAG="--env-file=.env"
else
  ENV_FILE_FLAG=""
fi

# Web UI 未构建时自动构建（desktop/dist 即 H5 浏览器客户端）
if [[ ! -f desktop/dist/index.html ]]; then
  echo "[aircode] 首次运行，正在构建 Web UI…"
  (cd desktop && bun run build)
fi

exec bun $ENV_FILE_FLAG ./src/server/index.ts "$@"
